<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Imagen del recurso -->
        <ImageView
            android:id="@+id/imagenRecurso"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:background="#EEEEEE"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Título -->
        <TextView
            android:id="@+id/textoTituloRecurso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Título del Recurso"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintTop_toTopOf="@id/imagenRecurso"
            app:layout_constraintStart_toEndOf="@id/imagenRecurso"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="12dp"/>

        <!-- Tipo -->
        <TextView
            android:id="@+id/textoTipoRecurso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Tipo: Libro"
            android:textSize="14sp"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintTop_toBottomOf="@id/textoTituloRecurso"
            app:layout_constraintStart_toStartOf="@id/textoTituloRecurso"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="4dp"/>

        <!-- Descripción corta -->
        <TextView
            android:id="@+id/textoDescripcionRecurso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Descripción detallada del recurso educativo..."
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintTop_toBottomOf="@id/textoTipoRecurso"
            app:layout_constraintStart_toStartOf="@id/textoTituloRecurso"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="4dp"/>

        <!-- Promedio / Rating -->
        <TextView
            android:id="@+id/textoPromedio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐ 4.5 (10 votos)"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/textoDescripcionRecurso"
            app:layout_constraintStart_toStartOf="@id/textoTituloRecurso"
            android:layout_marginTop="8dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>